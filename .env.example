# ── Grab A Sip — environment variables ───────────────────────────
# Copy to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
#
# Everything works WITHOUT these (the serviceability check runs on a
# static list); they only turn ON lead persistence + the CSV export.

# ── Admin app (Phase 3a) ─────────────────────────────────────────
# Supabase Auth (Project Settings → API). NEXT_PUBLIC_ so the login form
# (browser) can use them; the anon key is safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# The Java backend's ADMIN_TOKEN, held server-side so /admin can pull leads
# and stream the .xlsx without exposing it to the browser.
ADMIN_API_TOKEN=<same value as the backend ADMIN_TOKEN>

# ── Optional: direct Supabase writes from Next.js (only used when
#    API_BASE_URL is NOT set — the Java backend is the normal path) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protects GET /api/leads/export — pick any long random string.
ADMIN_TOKEN=

# Spring Boot API base URL (once deployed on Render/Railway). Server-side only.
# When set, the /api/leads route forwards leads to this backend; when empty it
# falls back to a direct Supabase write (or a no-op). No NEXT_PUBLIC_ prefix —
# it never needs to reach the browser.
# API_BASE_URL=https://grab-a-sip-api.onrender.com

# Optional: your production URL (used for absolute OG image links).
# NEXT_PUBLIC_SITE_URL=https://grab-a-sip.vercel.app
